<?xml version="1.0" encoding="utf-8"?>
<!-- 图标底板：白色为主，中央一圈极淡的品牌色呼吸光晕 + 一道同心环底纹。
     前景是彩色卡通简历，底板刻意保持安静，不与纸面争夺注意力；
     monochrome 只取前景 alpha，底板怎么改都不影响主题图标。 -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path android:pathData="M0,0h108v108h-108z" android:fillColor="#FFFFFF" />

    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="54"
                android:centerY="54"
                android:gradientRadius="52"
                android:startColor="#14168B68"
                android:centerColor="#08168B68"
                android:endColor="#00168B68" />
        </aapt:attr>
    </path>

    <path
        android:pathData="M54,54 m-41,0 a41,41 0 1,0 82,0 a41,41 0 1,0 -82,0"
        android:strokeColor="#0F168B68"
        android:strokeWidth="8" />
</vector>
